# Allowlist: only what a user needs to install HorizonX. Everything else stays out.
*
!.gitignore
!/LICENSE
!/README.es.md
!/README.md
!/THIRD_PARTY_NOTICES.md
!/licenses/
!/licenses/*.txt
!/companion/
!/companion/HorizonX.cmd
!/companion/HorizonX.sh
!/companion/README.md
!/companion/horizonx.py
!/companion/horizonx/
!/companion/horizonx/__init__.py
!/companion/horizonx/adb.py
!/companion/horizonx/guide.py
!/companion/horizonx/optimize.py
!/companion/profiles/
!/companion/profiles/platforms.json
!/companion/profiles/tv-database.json
!/dist/
!/dist/HorizonX-[0-9]*.apk
!/dist/HorizonX-[0-9]*-SHA256SUMS
!/dist/HorizonX-PC-*.zip
!/docs/
!/docs/*.md
!/docs/media/
!/docs/media/*.jpg
!/docs/media/*.gif
!/docs/media/*.mp4
!/otras-plataformas/
!/otras-plataformas/**
__pycache__/
*.pyc
